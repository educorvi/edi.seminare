<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    xmlns:plone="http://namespaces.plone.org/plone"
    i18n_domain="edi.seminare"
    >

  <include package="plone.app.contentmenu" />

  <browser:page
      name="pure-seminarangebot"
      for="edi.seminare.content.seminarangebot.ISeminarangebot"
      class=".pure_seminarangebot.PureSeminarangebot"
      template="pure_seminarangebot.pt"
      permission="zope2.View"
      />

  <browser:page
      name="cal-view"
      for="edi.seminare.content.seminarangebot.ISeminarangebot"
      class=".cal_view.CalView"
      template="cal_view.pt"
      permission="zope2.View"
      />

  <browser:page
      name="seminarkarten"
      for="Products.CMFCore.interfaces.IFolderish"
      class=".seminarkarten.Seminarkarten"
      template="seminarkarten.pt"
      permission="zope2.View"
      />

  <browser:page
      name="seminarliste"
      for="Products.CMFCore.interfaces.IFolderish"
      class=".seminarliste.Seminarliste"
      template="seminarliste.pt"
      permission="zope2.View"
      />

  <browser:page
      name="terminliste"
      for="Products.CMFCore.interfaces.IFolderish"
      class=".terminliste.Terminliste"
      template="terminliste.pt"
      permission="zope2.View"
      />

  <browser:page
      name="seminarangebot"
      for="edi.seminare.content.seminarangebot.ISeminarangebot"
      class=".seminarangebot.Seminarangebot"
      template="seminarangebot.pt"
      permission="zope2.View"
      />

  <browser:menuItems
      menu="plone_displayviews"
      for="*"
      >
    <browser:menuItem
        title="Seminare nach Themen"
        description="ABC-Ansicht fuer Plone"
        action="seminarliste"
        />
    <browser:menuItem
        title="Seminare nach Terminen"
        description="ABC-Ansicht fuer Plone"
        action="terminliste"
        />
    <browser:menuItem
        title="Seminare nach Unterordnern"
        description="ABC-Ansicht fuer Plone"
        action="seminarkarten"
        />
    <browser:menuItem
        title="Seminarangebot"
        description="Ansicht für ein Seminarangebot"
        action="seminarangebot"
        />
  </browser:menuItems>


</configure>
