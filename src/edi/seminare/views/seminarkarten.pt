<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      lang="en"
      metal:use-macro="context/main_template/macros/master"
      xml:lang="en"
      i18n:domain="example.conference"
>
  <body>
    <metal:main fill-slot="main">
      <tal:main-macro metal:define-macro="main">

        <div class="container"
             id="main-content"
             tal:define="
               allcards view/cardlist;
               batchvalue view/batchvalue;
               Batch python:modules['plone.batching'].Batch;
               b_size python:batchvalue;
               b_start python:0;
               b_start request/b_start | b_start;
               batch python:Batch(allcards, b_size, int(b_start), orphan=0);
             "
        >

          <div class="row">
            <span class="col-12"
                  tal:content="structure provider:plone.abovecontenttitle"
            ></span>
          </div>

          <!-- Start Folder Contents -->
          <div class="row">
            <!-- Left Column -->
            <div class="col-lg-9 col-12"
                 tal:attributes="
                   class view/contentcolumn;
                 "
            >
              <h1 tal:content="view/mytitle"></h1>
              <span tal:content="structure provider:plone.belowcontenttitle"></span>
              <p class="lead mt-5"
                 tal:condition="view/mydesc"
              >
                <span class="dot">
                  <svg xmlns="http://www.w3.org/2000/svg"
                       viewbox="0 0 500 500"
                  >
                    <defs></defs>
                    <circle cx="250"
                            cy="250"
                            fill="#0063af"
                            r="250"
                    ></circle>
                  </svg>
                </span>
                <span tal:content="view/mydesc"></span>
              </p>
              <div tal:content="structure view/myhtml"></div>
              <span tal:content="structure provider:plone.abovecontentbody"></span>
              <span tal:condition="not:allcards"
                    tal:content="view/emptymessage"
              ></span>
              <div tal:attributes="
                     class string:row row-cols-1 ${view/rowclass};
                   ">
                <div class="col mb-4"
                     tal:repeat="item batch"
                >
                  <div class="card h-100">
                    <img tal:condition="item/topimage"
                         tal:replace="structure item/topimage"
                    />
                    <div tal:condition="python: not item.get('topimage') and item.get('video')"
                         tal:attributes="
                           class python:item['video']['videoformat'];
                         "
                    >
                      <span tal:replace="structure item/video/embed"></span>
                    </div>
                    <div class="card-body">
                      <span tal:condition="item/review_class"
                            tal:content="item/review_title"
                            tal:attributes="
                              class string:badge badge-${item/review_class};
                            "
                      ></span>
                      <p class="card-body-roof"
                         tal:condition="python: view.showRoofLine() and item.get('dachzeile')"
                         tal:content="item/dachzeile"
                      ></p>
                      <h2 class="text-primary card-headline">
                        <a href="${item/url}"
                           tal:condition="not:item/shorttitle"
                           tal:content="item/title"
                        ></a>
                        <a href="${item/url}"
                           tal:condition="item/shorttitle"
                           tal:content="item/shorttitle"
                        ></a>
                      </h2>
                      <p class="card-text small"
                         tal:condition="view/showdesc"
                      >
                        <span class="description"
                              tal:content="item/description"
                        ></span>
                      </p>
                      <section class="mb-3"
                               tal:condition="item/seminare"
                      >
                        <p class="card-text small"
                           tal:repeat="termin item/seminare"
                        >
                          ${termin/zeit/day} | ${termin/ort}<br />
                          <a href="${termin/url}">${termin/title}</a>
                        </p>
                      </section>
                      <a href="${item/url}"
                         tal:condition="item/more_seminare"
                      >Alle Termine</a>
                    </div>
                    <a class="card-link stretched-link hover"
                       tal:condition="not:item/seminare"
                       tal:attributes="
                         href item/url;
                       "
                    ></a>
                  </div>
                </div>
              </div>

              <tal:batchnavigation define="
                                     batchnavigation nocall:context/@@batchnavigation;
                                   "
                                   replace="structure python:batchnavigation(batch)"
              />

            </div>
            <!-- End Left Column -->

            <!-- Portlets -->
            <div class="col-lg-3 col-12"
                 tal:condition="view/portletcolumn"
            >
              <div tal:replace="structure context/@@portlet-cards-view"></div>
            </div>
            <!-- Ende Portlets -->

          </div>
          <!-- End Folder Contents -->

          <div class="row">
            <span class="col-sm-9 col-12"
                  tal:content="structure provider:nva.contentcards"
                  tal:attributes="
                    class view/contentcolumn;
                  "
            ></span>
          </div>

          <div class="row"
               tal:condition="view/endhtml"
          >
            <div class="col-lg-9 col-12"
                 tal:content="structure view/endhtml"
                 tal:attributes="
                   class view/contentcolumn;
                 "
            ></div>
          </div>

          <div class="row">
            <span class="col-lg-9 col-12"
                  tal:content="structure provider:plone.belowcontentbody"
                  tal:attributes="
                    class view/contentcolumn;
                  "
            ></span>
          </div>

        </div>

      </tal:main-macro>
    </metal:main>
  </body>
</html>
